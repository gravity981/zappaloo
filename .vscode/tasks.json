{
  // Development servers without Docker or Caddy (README.md, "Quick start").
  // Run with Ctrl+Shift+P → "Tasks: Run Task" → "dev", then open http://localhost:5173.
  "version": "2.0.0",
  "inputs": [
    {
      "id": "resetConfirm",
      "type": "pickString",
      "description": "Delete all development data (database, uploads, maps, images) and load the example event? Stop \"dev: backend\" first.",
      "options": ["Cancel", "Clear and seed"],
      "default": "Cancel"
    }
  ],
  "tasks": [
    {
      "label": "db: clear and seed (dev)",
      "detail": "Deletes the development database and uploads, then loads the example event and the admin account admin (password admin; asks first; dev only). Stop \"dev: backend\" before.",
      "type": "shell",
      "command": "if [ \"${input:resetConfirm}\" = 'Clear and seed' ]; then npm run db:reset-dev; else echo 'Cancelled, nothing was deleted.'; fi",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "detail": "Backend (port 3000) and frontend (port 5173) in dev mode",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "detail": "API on port 3000, restarts on change, migrates the dev database",
      "type": "npm",
      "script": "dev:backend",
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "zappaloo-backend",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "Restarting|Watching",
          "endsPattern": "Server listening at"
        }
      }
    },
    {
      "label": "dev: frontend",
      "detail": "Vite on port 5173, forwards /api to the backend",
      "type": "npm",
      "script": "dev:frontend",
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "zappaloo-frontend",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "VITE v",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "mocks",
      "detail": "UX mocks (spec/mocks) on port 5174: http://localhost:5174/zappaloo-mocks.html (reload after a change)",
      "type": "npm",
      "script": "mocks",
      "isBackground": true,
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "zappaloo-mocks",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "^",
          "endsPattern": "UX mocks: http"
        }
      }
    }
  ]
}
