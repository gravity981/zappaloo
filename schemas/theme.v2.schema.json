{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "line": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "onAccent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "text",
        "muted",
        "line",
        "accent",
        "onAccent"
      ],
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "pattern": "^[\\p{L}\\p{N} -]{1,40}$"
            },
            "sizeAdjust": {
              "type": "integer",
              "minimum": 50,
              "maximum": 200
            },
            "files": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.woff2$"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  }
                },
                "required": [
                  "file",
                  "weight",
                  "style"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "family",
            "files"
          ],
          "additionalProperties": false
        },
        "heading": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "pattern": "^[\\p{L}\\p{N} -]{1,40}$"
            },
            "sizeAdjust": {
              "type": "integer",
              "minimum": 50,
              "maximum": 200
            },
            "files": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.woff2$"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  }
                },
                "required": [
                  "file",
                  "weight",
                  "style"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "family",
            "files"
          ],
          "additionalProperties": false
        },
        "display": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "pattern": "^[\\p{L}\\p{N} -]{1,40}$"
            },
            "sizeAdjust": {
              "type": "integer",
              "minimum": 50,
              "maximum": 200
            },
            "files": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.woff2$"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  }
                },
                "required": [
                  "file",
                  "weight",
                  "style"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "family",
            "files"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "waiting": {
      "type": "object",
      "properties": {
        "card": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "button": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "onButton": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "card",
        "text",
        "button",
        "onButton"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "colors"
  ],
  "additionalProperties": false
}
