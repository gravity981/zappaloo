{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "frameWidth": {
      "type": "integer",
      "minimum": 8,
      "maximum": 64
    },
    "frameHeight": {
      "type": "integer",
      "minimum": 8,
      "maximum": 64
    },
    "palettes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,20}$"
      },
      "additionalProperties": {
        "minItems": 1,
        "maxItems": 16,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "parts": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "palette": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,20}$"
            },
            "optional": {
              "type": "boolean"
            },
            "options": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  },
                  "detail": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "file"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "options"
          ],
          "additionalProperties": false
        },
        "outfit": {
          "type": "object",
          "properties": {
            "palette": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,20}$"
            },
            "optional": {
              "type": "boolean"
            },
            "options": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  },
                  "detail": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "file"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "options"
          ],
          "additionalProperties": false
        },
        "hair": {
          "type": "object",
          "properties": {
            "palette": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,20}$"
            },
            "optional": {
              "type": "boolean"
            },
            "options": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  },
                  "detail": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "file"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "options"
          ],
          "additionalProperties": false
        },
        "accessory": {
          "type": "object",
          "properties": {
            "palette": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,20}$"
            },
            "optional": {
              "type": "boolean"
            },
            "options": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  },
                  "detail": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.png$"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "file"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "options"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "body",
        "outfit",
        "hair",
        "accessory"
      ],
      "additionalProperties": false
    },
    "templates": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "avatar": {
            "type": "object",
            "properties": {
              "body": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,40}$"
              },
              "skin": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "outfit": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,40}$"
              },
              "outfitColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "hair": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hairColor": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accessory": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "body",
              "skin",
              "outfit",
              "outfitColor",
              "hair",
              "hairColor",
              "accessory"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "avatar"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "frameWidth",
    "frameHeight",
    "palettes",
    "parts",
    "templates"
  ],
  "additionalProperties": false
}
