# Copy to .env in the environment's directory on the server and adjust.
# deploy.sh maintains IMAGE_TAG and APP_VERSION_SUFFIX itself.

# --- Environment -------------------------------------------------------------
# staging or prod; must match the first argument of deploy.sh
APP_ENV=staging
COMPOSE_PROJECT_NAME=zappaloo-staging
# Docker volume with database, uploads and maps (prod: zappaloo-data-prod)
DATA_VOLUME=zappaloo-data-staging

# --- Address and HTTPS ---------------------------------------------------------
# prod: the domain, e.g. zappaloo.ch      staging: the LAN IP, e.g. 192.168.1.20
SITE_ADDRESS=192.168.1.20
# prod: contact email for Let's Encrypt   staging: internal (Caddy's local CA)
TLS_MODE=internal
HTTP_PORT=80
HTTPS_PORT=443

# --- Mail ------------------------------------------------------------------------
# staging: catch all mail in Mailpit (web UI on MAILPIT_UI_PORT); prod: leave empty
COMPOSE_PROFILES=mailpit
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
MAIL_FROM=zappaloo@example.ch

# --- Backups -------------------------------------------------------------------
# Host folder for database backups taken before each prod deployment. deploy.sh
# writes them itself (mode 600, owned by the user running deploy.sh).
BACKUP_DIR=./backups

# --- Registry --------------------------------------------------------------------
# Only if the image is private: user for the read-only token in ./ghcr-token
GHCR_USER=

# --- Set by deploy.sh --------------------------------------------------------------
IMAGE_TAG=
APP_VERSION_SUFFIX=
